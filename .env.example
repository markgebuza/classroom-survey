# Copy to .env.local and fill in values from Supabase -> Project Settings -> API.
# Only the public anon key belongs here. Never put the service-role key in any frontend file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Base URL used in QR codes and the public survey link, e.g. https://classroom-survey.pages.dev
# Leave empty to use the address the app is opened from (window.location.origin).
VITE_PUBLIC_SITE_URL=https://classroom-survey-cky.pages.dev/
